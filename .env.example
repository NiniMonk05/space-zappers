# Space Zappers configuration (copy to .env.local for `npm run dev`)
# Never put secrets in VITE_* variables: Vite bakes them into the public JS bundle.

# --- Frontend (build time, public) ---
# Game pubkey for leaderboard queries (hex, derived from GAME_NSEC)
VITE_GAME_PUBKEY=your_game_pubkey_hex_here

# --- Score service (runtime, server-side only) ---
# Nostr private key used to sign score events; without it score publishing is disabled
GAME_NSEC=nsec1your_game_nsec_here

# LNbits instance that holds the game wallet (no trailing slash)
LNBITS_URL=https://your-lnbits.example.com

# Invoice/read key of the game wallet - SECRET: it exposes the wallet balance and history
# Use the invoice key only, never the admin key
LNBITS_INVOICE_KEY=your_invoice_key_here

# Optional bounds for POST /api/invoice (sats)
# INVOICE_MIN_SATS=1
# INVOICE_MAX_SATS=1000

# Optional: number of reverse proxies in front of the score service (container nginx + host proxy)
# TRUSTED_PROXY_HOPS=2
